#!/usr/bin/env bash
# Enforces the commit rules of rules/always/git.md, then runs the project's
# `make quality` and `make test`. Both run here rather than in pre-commit because
# only this hook knows the commit type, and a test commit may hold failing tests.
set -euo pipefail

readonly MESSAGE_FILE="$1"
readonly HEADER_PATTERN='^(feat|fix|test|refactor|chore|docs)\([a-z0-9-]+\): [a-z0-9][^A-Z]*[^.]$'
readonly BREAKING_FOOTER_PATTERN='^BREAKING CHANGE: '
readonly SCISSORS_PATTERN='^# -+ >8 -+$'

message_lines=$(sed -E "/$SCISSORS_PATTERN/,\$d" "$MESSAGE_FILE" | grep -v '^#' | sed '/^[[:space:]]*$/d' || true)
header=$(head -n 1 <<<"$message_lines")
extra_lines=$(tail -n +2 <<<"$message_lines")

if ! [[ "$header" =~ $HEADER_PATTERN ]]; then
  echo "commit-msg: invalid header, expected <type>(<scope>): <lowercase description without trailing period>" >&2
  exit 1
fi

if [[ -n "$extra_lines" ]] && grep -qvE "$BREAKING_FOOTER_PATTERN" <<<"$extra_lines"; then
  echo "commit-msg: no body or footer allowed, except a BREAKING CHANGE footer" >&2
  exit 1
fi

run_target() {
  local target="$1"
  if ! make -n "$target" >/dev/null 2>&1; then
    echo "commit-msg: the project must define a 'make $target' target" >&2
    exit 1
  fi
  make "$target"
}

run_target quality

if [[ "$header" =~ ^test\( ]]; then
  run_target test || echo "commit-msg: failing tests tolerated in a test commit" >&2
else
  run_target test
fi
