#!/usr/bin/env bash
# Builds the project's AGENTS.md from the kernel rules and the project's own rules,
# so agents read every rule inline instead of being told to go and read files.
# Run from the project root: <kernel path>/scripts/compile-agents [--check]
set -euo pipefail
shopt -s nullglob

readonly KERNEL_PATH="${0%/scripts/compile-agents}"
readonly PROJECT_RULES_DIR="rules/project"
readonly OUTPUT_FILE="AGENTS.md"
readonly EXCEPTION_PREFIX_PATTERN='^As an exception to the kernel rules? '

# The kernel path is written into AGENTS.md, so it must stay relative to the project root.
if [[ "$KERNEL_PATH" == /* || ! -d "$KERNEL_PATH/rules/always" ]]; then
  echo "compile-agents: run it from the project root through the kernel's relative path, e.g. .agents/scripts/compile-agents" >&2
  exit 1
fi

# Included files keep their own headings; shifting them two levels nests them under their
# section. Blank lines are trimmed at both ends and collapsed inside, so formatters such as
# prettier leave the output unchanged.
append_section() {
  local title="$1" rule_file="$2"
  printf '\n## %s\n\n' "$title"
  sed -E 's/^(#+) /\1## /' "$rule_file" |
    awk 'NF { if (pending) print ""; print; started = 1; pending = 0; next } started { pending = 1 }'
}

render() {
  local rule_file
  printf '<!-- Generated by %s/scripts/compile-agents. Edit the kernel rules or %s/ instead. -->\n' "$KERNEL_PATH" "$PROJECT_RULES_DIR"
  printf '\n# Agent rules\n\n'
  printf 'A project rule overrides a kernel rule only when it names it as an exception.\n\n'
  printf 'Load a role from %s/skills/ only when assigned that role.\n' "$KERNEL_PATH"
  for rule_file in "$KERNEL_PATH"/rules/always/*.md; do
    append_section "Kernel — $(basename "$rule_file" .md)" "$rule_file"
  done
  for rule_file in "$PROJECT_RULES_DIR"/*.md; do
    append_section "Project — $(basename "$rule_file" .md)" "$rule_file"
  done
}

# Prints each kernel rule quoted by an exception, from the kernel and project rules alike.
quoted_kernel_rules() {
  cat "$KERNEL_PATH"/rules/always/*.md "$PROJECT_RULES_DIR"/*.md |
    sed -E 's/^- //' |
    grep -E "$EXCEPTION_PREFIX_PATTERN" |
    sed -E 's/^As an exception to the kernel rules? //; s/", .*$/"/' |
    grep -oE '"[^"]*"' |
    sed -E 's/^"(.*)"$/\1/'
}

# An exception must quote a kernel rule that still exists word for word; otherwise a
# kernel upgrade that rewords the rule would leave the exception pointing at nothing.
check_quoted_kernel_rules() {
  local kernel_rules quoted_rule is_valid=true
  kernel_rules="$(sed -E 's/^- //' "$KERNEL_PATH"/rules/always/*.md)"
  while IFS= read -r quoted_rule; do
    if ! grep -qxF -- "$quoted_rule" <<<"$kernel_rules"; then
      echo "compile-agents: no kernel rule reads \"$quoted_rule\"; update the exception that quotes it" >&2
      is_valid=false
    fi
  done < <(quoted_kernel_rules)
  [[ "$is_valid" == true ]]
}

check_quoted_kernel_rules || exit 1

if [[ "${1:-}" == "--check" ]]; then
  if ! cmp -s <(render) "$OUTPUT_FILE"; then
    echo "compile-agents: $OUTPUT_FILE is out of date, run $KERNEL_PATH/scripts/compile-agents" >&2
    exit 1
  fi
else
  render >"$OUTPUT_FILE"
fi
